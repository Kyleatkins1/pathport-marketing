# PathPort Marketing — Environment Variables
# Copy to .env (or configure in Cloudflare Pages Dashboard -> Settings -> Environment Variables)

# Public Application URL (for "Sign In" and direct app launch links)
PUBLIC_APP_URL="https://app.getpathport.com"
VITE_APP_URL="https://app.getpathport.com"

# Launch Mode: "founding_access" (Waitlist + 30-Day Pro Trial modal) or "live" (Direct signup handoff for Individuals)
PUBLIC_LAUNCH_MODE="founding_access"

# Loops.so API Key (Server-side secret for Cloudflare Pages Function /api/beta-signup)
LOOPS_API_KEY="your_loops_api_key_here"

# Loops.so Mailing List IDs per Conversion Track
LOOPS_LIST_INDIVIDUAL_ID="cmstx4t94ey4r0jx5a3psh1cb"
LOOPS_LIST_WORKPLACE_ID=""
LOOPS_LIST_CERTIFY_ID=""
