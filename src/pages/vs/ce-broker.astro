---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { VsCeBroker, CE_BROKER_FAQS } from '../../views/VsCeBroker';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: CE_BROKER_FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title="CE Broker Alternative: PathPort vs. CE Broker"
  description="Compare PathPort as a CE Broker alternative: track 50-state RN/EMS CEUs, national certs, encrypted documents, MyPortfolio, and MyPath Career in one place."
  canonicalPath="/vs/ce-broker/"
  includeSoftwareSchema={true}
  breadcrumbs={[
    { name: 'CE Broker Alternative', path: '/vs/ce-broker/' },
  ]}
  extraJsonLd={faqSchema}
>
  <VsCeBroker client:load />
</BaseLayout>

