---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { RenewalCalculator } from '../../../views/RenewalCalculator';
import {
  STATE_RENEWAL_DATA,
  NATIONAL_CREDENTIAL_RULES,
  buildStateFaqs,
  buildNationalFaqs,
  type StateRenewalRule,
  type NationalCredentialRule,
} from '../../../data/stateRenewalData';

export function getStaticPaths() {
  const statePaths = STATE_RENEWAL_DATA.map((stateProfile) => ({
    params: { state: stateProfile.slug },
    props: { kind: 'state' as const, stateProfile },
  }));

  const nationalPaths = NATIONAL_CREDENTIAL_RULES.map((nationalProfile) => ({
    params: { state: nationalProfile.slug },
    props: { kind: 'national' as const, nationalProfile },
  }));

  return [...statePaths, ...nationalPaths];
}

type Props =
  | { kind: 'state'; stateProfile: StateRenewalRule }
  | { kind: 'national'; nationalProfile: NationalCredentialRule };

const props = Astro.props;

function truncateMeta(text: string, maxLen = 158): string {
  if (text.length <= maxLen) return text;
  const cut = text.slice(0, maxLen - 1);
  const lastSpace = cut.lastIndexOf(' ');
  return `${(lastSpace > 100 ? cut.slice(0, lastSpace) : cut).replace(/[.,;:\s]+$/, '')}.`;
}

let pageTitle = '';
let pageDescription = '';
let canonicalPath = '';
let breadcrumbName = '';
let faqSchema: Record<string, unknown> = {};
let webAppName = '';

if (props.kind === 'state') {
  const { stateProfile } = props;
  const candidateTitle = `${stateProfile.name} (${stateProfile.code}) Nursing CE Requirements | PathPort`;
  pageTitle =
    candidateTitle.length <= 60
      ? candidateTitle
      : `${stateProfile.name} (${stateProfile.code}) Nursing CE Rules | PathPort`;

  const rawDesc =
    stateProfile.totalHours > 0
      ? `${stateProfile.name} RN license renewal: ${stateProfile.totalHours} CE hours every ${stateProfile.cycleYears} year${stateProfile.cycleYears > 1 ? 's' : ''} (${stateProfile.boardName}). ${stateProfile.mandatoryTopics.length > 0 ? `${stateProfile.mandatoryTopics.length} mandatory topic rules` : 'General board CE'} and NLC status.`
      : `${stateProfile.name} RN renewal (${stateProfile.boardName}): ${stateProfile.cycleYears}-year cycle via practice hours or national certification. Check full topic rules.`;
  pageDescription = truncateMeta(rawDesc, 158);
  canonicalPath = `/tools/renewal-calculator/${stateProfile.slug}/`;
  breadcrumbName = `${stateProfile.name} (${stateProfile.code}) RN Renewal`;
  webAppName = `${stateProfile.name} (${stateProfile.code}) RN CE Renewal Calculator`;

  faqSchema = {
    '@type': 'FAQPage',
    mainEntity: buildStateFaqs(stateProfile).map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  };
} else {
  const { nationalProfile } = props;
  pageTitle = nationalProfile.seoTitle;
  const rawDesc = `${nationalProfile.name} (${nationalProfile.issuer}): ${nationalProfile.totalUnits} ${nationalProfile.unitLabel} every ${nationalProfile.cycleMonths / 12} years. Free category breakdown & renewal calculator.`;
  pageDescription = truncateMeta(rawDesc, 158);
  canonicalPath = `/tools/renewal-calculator/${nationalProfile.slug}/`;
  breadcrumbName = nationalProfile.name;
  webAppName = `${nationalProfile.name} Renewal Calculator`;

  faqSchema = {
    '@type': 'FAQPage',
    mainEntity: buildNationalFaqs(nationalProfile).map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  };
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  webAppSchema={{
    name: webAppName,
    description: pageDescription,
  }}
  breadcrumbs={[
    { name: '50-State Renewal Calculator', path: '/tools/renewal-calculator/' },
    { name: breadcrumbName, path: canonicalPath },
  ]}
  extraJsonLd={faqSchema}
>
  {props.kind === 'state' ? (
    <RenewalCalculator initialStateCode={props.stateProfile.code} client:load />
  ) : (
    <RenewalCalculator initialCertCode={props.nationalProfile.code} client:load />
  )}
</BaseLayout>
