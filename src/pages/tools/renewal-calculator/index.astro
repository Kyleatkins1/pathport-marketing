---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { RenewalCalculator } from '../../../views/RenewalCalculator';
---

<BaseLayout
  title="50-State License & CEU Renewal Calculator | PathPort"
  description="Check continuing education hours, mandatory topics, and renewal cycles free across all 50 US states, DC, ANCC, AACN, NREMT, PMI PMP, CISSP, and Security+."
  canonicalPath="/tools/renewal-calculator/"
  webAppSchema={{
    name: 'PathPort 50-State & National Board Renewal Calculator',
    description:
      'Free calculator for nursing CE contact hours, mandatory state topics, and national board recertification credits (PMP, CISSP, Security+, NREMT, ANCC, AACN).',
  }}
  breadcrumbs={[
    { name: '50-State Renewal Calculator', path: '/tools/renewal-calculator/' },
  ]}
>
  <RenewalCalculator client:load />
</BaseLayout>

