---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ParamedicsFunnel } from '../../views/ParamedicsFunnel';
---

<BaseLayout
  title="PathPort for Paramedics & Flight Crews (NRP, FP-C, EMT) — NREMT NCCP 2025 Tracker"
  description="Track NREMT National, State/Local, and Individual NCCP hours, IBSC FP-C/CCP-C renewals, and high-acuity transport logs in one portable record."
  canonicalPath="/for/paramedics"
  includeSoftwareSchema={true}
  breadcrumbs={[
    { name: 'For Paramedics & EMS', path: '/for/paramedics' },
  ]}
>
  <ParamedicsFunnel client:load />
</BaseLayout>

